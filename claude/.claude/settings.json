{
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "deny": [
      "Read(**/*.png)",
      "Read(**/*.PNG)",
      "Read(**/*.jpg)",
      "Read(**/*.JPG)",
      "Read(**/*.jpeg)",
      "Read(**/*.JPEG)",
      "Read(**/*.gif)",
      "Read(**/*.GIF)",
      "Read(**/*.webp)",
      "Read(**/*.WEBP)",
      "Read(**/*.bmp)",
      "Read(**/*.BMP)",
      "Read(**/*.tif)",
      "Read(**/*.TIF)",
      "Read(**/*.tiff)",
      "Read(**/*.TIFF)",
      "Read(**/*.heic)",
      "Read(**/*.HEIC)",
      "Read(**/*.avif)",
      "Read(**/*.ico)",
      "Read(**/*.pdf)",
      "Read(**/*.PDF)",
      "Bash(bkt pr merge)",
      "Bash(bkt pr merge *)",
      "Bash(bkt * pr merge*)",
      "Bash(bkt api *merge*)",
      "Edit(~/Dev/work/work-repo*/**/tests/acceptance/**)",
      "Edit(~/Dev/work/work-repo*/**/ci/**)",
      "Edit(~/Dev/work/work-repo*/**/bitbucket-pipelines.yml)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/ktjhia/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/ktjhia/.claude/hooks/herdr-restore-name.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I /Users/ktjhia/.claude/hooks/block-screenshots.py",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I /Users/ktjhia/.claude/hooks/netskope-stop-failure.py",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/ktjhia/.claude/statusline-command.sh"
  },
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "theme": "auto",
  "editorMode": "vim",
  "autoCompactEnabled": true,
  "advisorModel": "fable"
}
